# Finera backend configuration.
# Every service used is 100% free. No credit card required, anywhere.
#
#   - Groq AI:        https://console.groq.com  (free tier, no card)
#   - Currency rates: https://open.er-api.com   (free, no key, no signup)
#
# Leave GROQ_API_KEY blank to disable AI features; the app still works.

# Groq API key for AI insights. Sign up free at https://console.groq.com
# Free tier: ~30 requests/min, generous daily limit. No credit card required.
GROQ_API_KEY=

# Server bind
HOST=0.0.0.0
PORT=8000
RELOAD=0
LOG_LEVEL=INFO

# CORS origins (comma separated). Use explicit origins in production.
# Leave as * for local development.
CORS_ORIGINS=*

# Currency conversion (all providers are free, no API key required)
# How long to cache rates in seconds (default 1h)
CURRENCY_CACHE_TTL=3600
# HTTP request timeout in seconds
CURRENCY_REQUEST_TIMEOUT=10

# Auto-update mechanism
# Bump this AND frontend/.env VITE_APP_VERSION together when releasing.
APP_VERSION=1.2.0
# Where to download the new APK. Use any free static host:
#   - GitHub Releases:   https://github.com/<user>/<repo>/releases/download/v1.2.0/finera.apk
#   - Cloudflare R2:     https://pub-xxx.r2.dev/finera-1.2.0.apk
#   - Netlify Drop:      https://xxx.netlify.app/finera-1.2.0.apk
#   - Local:             http://<lan-ip>:8000/static/finera.apk
APK_DOWNLOAD_URL=
# Short release notes shown in the in-app update banner
UPDATE_NOTES=
# Force users below this version to update (default: 1.0.0)
UPDATE_FORCE_BELOW=1.0.0
