# Local dev defaults. Override with .env.local for production / phone testing.
# When VITE_API_PREFIX is empty, the frontend talks to the backend directly
# (e.g. http://localhost:8000). Keep /api for the Vite dev proxy.
VITE_API_PREFIX=/api
VITE_API_TARGET=http://localhost:8000
VITE_API_BASE=
VITE_HOST=true

# App version sent to /api/updates/latest on launch.
# MUST match APP_VERSION in backend/.env. Bump both together when releasing.
VITE_APP_VERSION=1.2.0
